# Leave OPENAI_API_KEY empty to use the free NVIDIA Nemotron tier (backend/free_tier.json).
# Set LLM_FREE_TIER=false to run fully offline with no LLM.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_FREE_TIER=true
LLM_REASONING_EFFORT=
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=5000
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.60
SEMANTIC_CACHE_VARIATION_THRESHOLD=0.60
SEMANTIC_CACHE_SEED_VARIATIONS=true
MAX_QUERY_CHARS=2000
LLM_COST_PER_CALL_USD=0.0004
RELEVANCE_LLM_TIMEOUT_SECONDS=5
RELEVANCE_LLM_ON_CACHE_HIT=false
LLM_EXTRA_BODY=
LLM_CALL_TIMEOUT_SECONDS=6
LLM_REQUEST_BUDGET_SECONDS=5.5
LLM_MIN_CALL_SECONDS=1
LLM_BREAKER_FAILURES=2
LLM_BREAKER_COOLDOWN_SECONDS=60
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DENSE_MIN_SCORE=0.74
CACHE_PERSIST_INTERVAL_SECONDS=5
CACHE_PREWARM=true
EMBEDDING_THREADS=1
SEMANTIC_RELEVANCE_ENABLED=true
SEMANTIC_RELEVANCE_MARGIN=0.0
COALESCE_WAIT_SECONDS=15
